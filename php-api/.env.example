# Same database as the Laravel admin
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lost_found_db
DB_USERNAME=root
DB_PASSWORD=
# Keep scope aligned with the values configured in Laravel / Admin > Department settings.
DEPFIND_DEPARTMENT_NAME="Department"
DEPFIND_LOCATIONS="Department Building"
DEPFIND_PICKUP_LOCATION="Department Lost and Found Desk"
# How many days a sign-in lasts
TOKEN_DAYS=7
# Optional: base URL used in photo links (set to your PC's LAN address so the phone can load photos)
# PUBLIC_URL=http://192.168.1.10:8000
# Comma-separated exact browser app origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200,http://localhost,capacitor://localhost
